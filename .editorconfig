# EditorConfig — https://editorconfig.org
# Allineato a tools/lint_style.py: UTF-8, LF, nessun trailing whitespace,
# righe <= 100 caratteri nel codice Python.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.py]
indent_size = 4

[*.{md,markdown}]
# In Markdown due spazi finali sono un interruzione di riga voluta.
trim_trailing_whitespace = false
max_line_length = 120

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.sh]
indent_size = 4

[Makefile]
indent_style = tab
