# =========================================================
# BYTE-SWARMY — variabili d'ambiente supportate (esempio)
# =========================================================
# Copia in `.env` (gitignored) e carica ESPLICITAMENTE prima di avviare:
#   set -a; source .env; set +a
#
# Il progetto NON usa python-dotenv: il file .env non viene letto in
# automatico. Per le chiavi cloud è preferito state/cloud_api.json (0600).
# NON mettere chiavi vere in questo file: solo in .env (gitignored) o
# nella GUI tramite il pulsante 🔑.

# --- Provider cloud per il pannello Chat (tier gratuito) ---
# Ordine di risoluzione: variabile d'ambiente -> state/cloud_api.json
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Debug / test GUI (opzionali) ---
# BSWARM_GUI_DEBUG=1          # dettagli su stdout in tools/gui_diag.py
# BSWARM_WORKFLOW_SHOTS=1     # screenshot per pagina nei test workflow
# BSWARM_TEST_MCP_PORT=8765   # porta fissa per test_mcp_e2e.py

# --- Coda task / MCP (opzionali) ---
# BW_TASKS_DB=/percorso/assoluto/queue.db   # forza il DB degli "first try"
# MCP_HOST=127.0.0.1        # default di tests/example_mcp_server.py
# MCP_PORT=8080             # default di tests/example_mcp_server.py

# --- Sandbox (opzionale, richiede privilegi) ---
# SANDBOX_DISABLE_USERNS=1  # disabilita user namespace non supportati
