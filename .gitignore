# =========================================================
# BYTE-SWARMY .gitignore
# Regola: solo codice sorgente e documentazione nel repo.
# Tutto ciò che è runtime, temporaneo o generato va escluso.
# =========================================================

# --- Virtualenv ---
.venv/
venv/
env/
ENV/

# --- Python cache ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# --- Stato runtime (NON versionare: può contenere task e audit sensibili) ---
state/
logs/
backups/

# --- Codice generato dai worker ---
# il contenuto di project/ è "miele" prodotto dallo swarm:
# rigenerabile, potenzialmente grande, non va su GitHub.
# Tieni solo un .gitkeep per preservare la directory.
project/*
!project/.gitkeep

# --- File temporanei e di backup ---
*.tmp
*.bak
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Backup di script locali (es. VECCHIA_sync.sh) ---
VECCHIA_*
*_old
*.orig
*.rej

# --- Config locale con credenziali MCP ---
mcp_servers.json
mcp_servers.local.json

# --- File di stato locale (ridondante ma esplicito) ---
state/orchestrator.pid
logs/stdout.log
logs/byte-swarmy.log
logs/security.log

# --- Environment / secrets ---
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json

# --- IDE ---
.vscode/
.idea/
*.code-workspace
*.iml
.project
.classpath
.settings/

# --- AI agenti locali ---
.claude/
.cursor/
.aider*
.continue/

# --- OS ---
.directory
.Trash-*
ehthumbs.db
Desktop.ini

# --- Build artifacts locali ---
build/
dist/
*.so
*.dylib

# Impedisce ai worker di rendere project/ un submodule
project/.git/
project/.git/

# File temporanei di Kate (editor KDE)
.README.md.kate-swp
*.kate-swp
README_IT_*.md

# File temporanei di Kate (editor KDE)
*.kate-swp
.README.md.kate-swp
README_IT_*.md

# Icone derivate temporanee (tieni solo la .ico originale)
IMG/icona-256-*.png

# File temporanei di fix/patch
fix_*.py
*.bak.*
*.bak2
*.bak3
state/last_metrics.json

# File temporanei di fix/patch (non committare)
fix_*.py
*_patch.py
apply_*.py
add_*.py
redesign_*.py

# Backup locali
*.bak
*.bak.*

# Cache Python
__pycache__/
*.pyc

# Metriche runtime
state/last_metrics.json
