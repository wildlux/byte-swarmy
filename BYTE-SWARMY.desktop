#!/usr/bin/env xdg-open
[Desktop Entry]
Version=1.0
Type=Application
Name=BYTE-SWARMY
Name[it]=BYTE-SWARMY
GenericName=Autonomous Programming Intelligence Swarm
GenericName[it]=Sciame autonomo di programmazione
Comment=Avvia BYTE-SWARMY: orchestratore + GUI
Comment[it]=Avvia BYTE-SWARMY: orchestratore + GUI
# Sostituisci PATH con la tua directory effettiva (default: ~/Desktop/byte-swarmy)
Exec=bash -c 'cd ~/Desktop/byte-swarmy && ./avvia.sh'
# Icon: usa un'icona generica di sistema (sostituisci con la tua se ce l'hai)
Icon=utilities-terminal
Terminal=false
Categories=Development;IDE;Utility;
Keywords=ai;swarm;agent;coding;autonomous;
StartupNotify=true
StartupWMClass=BYTE-SWARMY
