/* BYTE-SWARMY - tema scuro */
* { font-family: "Inter", "Noto Sans", "DejaVu Sans", sans-serif; font-size: 10.5pt; font-style: normal; font-weight: 400; }
QWidget { background: #14171d; color: #e6e9ef; }
QMainWindow, QDialog { background: #14171d; }
QToolTip { background: #e6e9ef; color: #1b1f27; border: none; padding: 4px 8px; }

/* Tab */
QTabWidget::pane { border: none; border-top: 1px solid #2a303b; background: #14171d; }
QTabBar::tab { background: transparent; color: #9aa4b5; padding: 8px 16px; border: none; border-bottom: 2px solid transparent; margin-right: 4px; }
QTabBar::tab:hover { color: #e6e9ef; }
QTabBar::tab:selected { color: #e6e9ef; font-weight: 600; border-bottom: 2px solid #5b92ff; }

/* Bottoni */
QPushButton { background: #1b1f27; border: 1px solid #363d4a; border-radius: 6px; padding: 6px 12px; }
QPushButton:hover { background: #242a35; border-color: #4a5365; }
QPushButton:pressed { background: #2b3340; }
QPushButton:focus { border-color: #5b92ff; }
QPushButton:disabled { color: #5f6878; background: #1e232c; }
QPushButton[role="primary"] { background: #5b92ff; color: #1b1f27; border-color: #5b92ff; font-weight: 600; }
QPushButton[role="primary"]:hover { background: #4a82f0; }
QPushButton[role="danger"] { color: #e5584a; }
QPushButton[role="danger"]:hover { background: #3d1b17; border-color: #7a3b34; }
QPushButton[role="start"] { background: #2aa86e; color: #1b1f27; border-color: #2aa86e; font-weight: 600; }
QPushButton[role="start"]:hover { background: #6fd3a1; }
QPushButton[role="stop"] { background: #e5584a; color: #1b1f27; border-color: #e5584a; font-weight: 600; }

/* Campi */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QPlainTextEdit, QTextEdit {
    background: #1b1f27; border: 1px solid #363d4a; border-radius: 6px; padding: 5px 8px;
    selection-background-color: #27427a; selection-color: #e6e9ef; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus { border: 1px solid #5b92ff; }
QLineEdit[placeholderText=""] { }
QLineEdit { placeholder-text-color: #6b7587; }
QLineEdit#quickCommand { padding: 8px 12px; font-size: 11.5pt; }
QPlainTextEdit#logView, QPlainTextEdit#tomlView, QTextEdit#logView {
    font-family: "JetBrains Mono", "Fira Code", "DejaVu Sans Mono", monospace; font-size: 9.5pt; background: #161a21; }

/* Tabelle e alberi */
QTableView, QTreeView, QTableWidget, QTreeWidget { background: #1b1f27; border: 1px solid #2a303b; border-radius: 6px;
    alternate-background-color: #1e232c; gridline-color: transparent; selection-background-color: #1f3560; selection-color: #e6e9ef; }
QTableView::item, QTreeView::item { padding: 6px 8px; border: none; }
QTableView::item:hover, QTreeView::item:hover { background: #232935; }
QHeaderView::section { background: #14171d; color: #9aa4b5; font-weight: 600; padding: 6px 8px; border: none; border-bottom: 1px solid #2a303b; }

/* Gruppi e pannelli */
QGroupBox { background: #1b1f27; border: 1px solid #2a303b; border-radius: 8px; margin-top: 14px; padding: 12px 10px 10px 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 6px; color: #9aa4b5; font-weight: 600; background: #14171d; }
QFrame#card { background: #1b1f27; border: 1px solid #2a303b; border-radius: 8px; }
QLabel { background: transparent; }
QLabel[role="muted"] { color: #8f99ab; }
QLabel[role="hint"] { color: #8f99ab; font-size: 9.5pt; }
QLabel[role="metric"] { font-size: 20pt; font-weight: 600; }

/* Badge di stato (imposta la property "state" sul QLabel) */
QLabel[state="done"] { color: #6fd3a1; background: #173626; border-radius: 9px; padding: 2px 10px; }
QLabel[state="running"] { color: #a9c6ff; background: #1f3560; border-radius: 9px; padding: 2px 10px; }
QLabel[state="pending"] { color: #f0c56a; background: #3d2f10; border-radius: 9px; padding: 2px 10px; }
QLabel[state="failed"] { color: #ff9b8f; background: #3d1b17; border-radius: 9px; padding: 2px 10px; }

/* Indicatore Timestral (property "thermal") */
QLabel[thermal="normal"] { color: #6fd3a1; background: #173626; border-radius: 12px; padding: 4px 12px; font-weight: 600; }
QLabel[thermal="warm"] { color: #f0c56a; background: #3d2f10; border-radius: 12px; padding: 4px 12px; font-weight: 600; }
QLabel[thermal="hot"] { color: #ff9b8f; background: #3d1b17; border-radius: 12px; padding: 4px 12px; font-weight: 600; }

/* Banner info/ok/errore (property "banner") */
QLabel[banner="info"] { background: #1a2a4a; color: #a9c6ff; border-radius: 6px; padding: 8px 12px; }
QLabel[banner="ok"] { background: #173626; color: #6fd3a1; border-radius: 6px; padding: 8px 12px; }
QLabel[banner="error"] { background: #3d1b17; color: #ff9b8f; border-radius: 6px; padding: 8px 12px; }

/* Barre, slider, checkbox */
QProgressBar { background: #2a303b; border: none; border-radius: 4px; height: 8px; text-align: center; color: transparent; }
QProgressBar::chunk { background: #2aa86e; border-radius: 4px; }
QSlider::groove:horizontal { height: 4px; background: #363d4a; border-radius: 2px; }
QSlider::handle:horizontal { background: #5b92ff; width: 14px; height: 14px; margin: -5px 0; border-radius: 7px; }
QSlider::sub-page:horizontal { background: #5b92ff; border-radius: 2px; }
QCheckBox { spacing: 8px; background: transparent; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #4a5365; border-radius: 4px; background: #1b1f27; }
QCheckBox::indicator:checked { background: #5b92ff; border-color: #5b92ff; }

/* Scrollbar sottili */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #3d4553; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #566073; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: #3d4553; border-radius: 5px; min-width: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* Menu, splitter, barra di stato */
QMenu { background: #1b1f27; border: 1px solid #363d4a; border-radius: 6px; padding: 4px; }
QMenu::item { padding: 6px 20px; border-radius: 4px; }
QMenu::item:selected { background: #1f3560; }
QSplitter::handle { background: #2a303b; }
QStatusBar { background: #1b1f27; border-top: 1px solid #2a303b; color: #9aa4b5; }
