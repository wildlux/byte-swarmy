-            failed += 1
-        except Exception as e:
-            self.output.appendPlainText(f"  ✗  CONFIG/config.toml — PARSE ERROR: {e}")
-            failed += 1
-        self.output.appendPlainText("")
-
-        # ── Riepilogo ─────────────────────────────────────────────────
