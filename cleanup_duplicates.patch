-
-        # ── Test 3: py_compile di ogni .py in CORE/ e GUI/ ─────────────
-        self.output.appendPlainText("─── Test 3: Sintassi Python (py_compile) ───")
-        for sub in ("CORE", "GUI", "SAFETY"):
