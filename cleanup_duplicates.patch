-                    hashes[fname] = h
-                    self.output.appendPlainText(f"  ✓  {fname}  sha256:{h}...")
-                    passed += 1
-                except OSError as e:
-                    self.output.appendPlainText(f"  ✗  {fname}  errore: {e}")
-                    failed += 1
