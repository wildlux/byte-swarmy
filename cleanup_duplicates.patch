-
-set -e
 
 SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
-cd "$SCRIPT_DIR"
-
-PID_FILE="state/orchestrator.pid"
-
-if [ ! -f "$PID_FILE" ]; then
-    echo "○ Nessun orchestratore attivo"
-    exit 0
-fi
-
-PID=$(cat "$PID_FILE" 2>/dev/null || true)
-
-# Non fidarsi del pid file: potrebbe essere vecchio o manomesso.
