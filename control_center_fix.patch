+    def _on_accordion_toggled(self, expanded: bool):
+        """Comportamento accordion sulle 5 sezioni collassabili.
+
+        Quando una sezione viene espansa manualmente dall'utente, tutte le
+        altre si collassano automaticamente. In questo modo nella schermata
+        resta visibile SOLO il menù scelto (una sezione aperta alla volta),
+        non tutti i menù aperti insieme.
+
+        Se l'utente collassa una sezione (expanded=False), non facciamo nulla:
+        le altre restano nello stato in cui sono.
+        """
+        if not expanded:
+            return
+        sender = self.sender()
+        for section in getattr(self, "_accordion_sections", []):
+            if section is not sender and section._expanded:
+                section.set_expanded(False)
     
